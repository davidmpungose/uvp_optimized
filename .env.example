# Copy this file to .env and replace placeholders locally.
# Never commit .env.

DB_SERVER=YOUR_SQL_SERVER
DB_DATABASE=YOUR_DATABASE
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=yes
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
DB_TIMEOUT_SECONDS=0

SOURCE_SCHEMA=stg
SOURCE_TABLE=Declarations
ANALYTICS_SCHEMA=analytics
PREPARED_TABLE=PreparedDeclarations
BENCHMARK_TABLE=OriginalBenchmarks
CLUSTER_RESULTS_TABLE=ClusterResults
CASE_RESULTS_TABLE=CaseResults
RUN_LOG_TABLE=PipelineRunLog

API_HOST=127.0.0.1
API_PORT=8080
API_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
API_DEFAULT_PAGE_SIZE=25
API_MAXIMUM_PAGE_SIZE=200
API_MAXIMUM_SELECTED_QUARTERS=40
